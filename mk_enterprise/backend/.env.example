# ─── MongoDB ─────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shopbill?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────
# Generate a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Admin Credentials (set once on first run) ───────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_MOBILE=9800000000

# ─── Twilio (for OTP via SMS) ────────────────────────
# Get from: https://twilio.com → Console
# If you don't have Twilio, OTP will be logged to console (dev mode)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend URL (for CORS) ─────────────────────────
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
